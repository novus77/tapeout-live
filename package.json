{
  "name": "tapeout-live",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src '*.{json,ts,js,html}'",
    "format:check": "prettier --check src '*.{json,ts,js,html}'",
    "lint": "eslint src",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.5"
  }
}
