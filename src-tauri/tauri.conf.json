{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TapeOut Live", "version": "0.1.0", "identifier": "io.tapeout.live",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "TapeOut Live", "width": 408, "height": 740, "visible": false, "resizable": true, "minWidth": 320, "minHeight": 400, "decorations": false, "skipTaskbar": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; script-src 'self'" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "category": "Finance", "shortDescription": "Your TapeOut mining monitor", "macOS": { "minimumSystemVersion": "13.0" }, "windows": { "nsis": { "installMode": "currentUser" } } }
}
